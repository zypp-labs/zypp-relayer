# Required
# For Supabase, use the TRANSACTION POOLER URI, not a direct connection.
# Project Settings > Database > Connection string > Transaction pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
# The aws-<n> prefix is assigned per project (this one is aws-1) — copy it from
# the dashboard rather than assuming aws-0.
# Direct-connection hostnames (db.<project-ref>.supabase.co) are retired for
# newer projects and will not resolve; createPool refuses them with this note.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zrn

# Supabase's pooler presents a certificate signed by Supabase's own CA, which is
# not in Node's trust store — without this, a verified connection fails with
# SELF_SIGNED_CERT_IN_CHAIN. Download it from:
#   Project Settings > Database > SSL Configuration > Download certificate
# Accepts a path to the .crt, or the PEM contents inline (for Render, paste the
# whole certificate as the value). This keeps verification ON — prefer it over
# DATABASE_SSL_NO_VERIFY below.
# DATABASE_CA_CERT=./certs/prod-ca-2021.crt

# Fallback for when no CA bundle is available. The connection stays encrypted but
# the server is no longer authenticated, so it becomes interceptable. Warns on
# every startup while set, and is IGNORED if DATABASE_CA_CERT is also set.
# DATABASE_SSL_NO_VERIFY=true

# Supabase (service_role bypasses RLS — use the service role key from Supabase dashboard > Settings > API)
NODE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RPC_URLS=https://api.devnet.solana.com
RELAYER_INTENT_DOMAIN=
FEE_PAYER_SECRET_KEY=
# The key users approve as delegate over their token accounts, as a JSON byte
# array. Required for relayer-constructed settlement; everything else works
# without it.
#
# MUST NOT be the same value as FEE_PAYER_SECRET_KEY. The fee payer spends only
# the relayer's own SOL; this key moves other people's tokens up to whatever
# each user approved. Keeping them separate means leaking the cheap one does not
# drain balances.
DELEGATE_SECRET_KEY=
# Optional (for metrics/enrichment)
# USDC_MINT_ADDRESS=
# HOT_WALLET_ADDRESS=

# Optional
REDIS_URL=redis://localhost:6379
PORT=4000
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BULL_CONCURRENCY=5
BULL_MAX_ATTEMPTS=5
BULL_BACKOFF_MS=1000
RPC_CONFIRMATION_COMMITMENT=confirmed
RPC_CONFIRMATION_TIMEOUT_MS=60000
RELAYER_API_KEY=

# Phase 5 — Monetization (optional for now)
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Circuit-breaker alerting (Telegram). Optional — when absent, breaker trips are
# logged but nothing is paged.
#
# TELEGRAM_BOT_TOKEN is the zypp_ceiling_alert_bot API token from @BotFather.
# TELEGRAM_ALERT_CHAT_ID is the "Zypp Ceiling Alert" destination: a @username
# for a public channel, or the numeric ID (negative) for a private group/channel.
# See OPERATIONS.md "Alerting destination".
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALERT_CHAT_ID=
