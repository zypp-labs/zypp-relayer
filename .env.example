# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zrn

# Supabase (service_role bypasses RLS — use the service role key from Supabase dashboard > Settings > API)
NODE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RPC_URLS=https://api.devnet.solana.com
RELAYER_INTENT_DOMAIN=
FEE_PAYER_SECRET_KEY=
# Optional (for metrics/enrichment)
# USDC_MINT_ADDRESS=
# HOT_WALLET_ADDRESS=

# Optional
REDIS_URL=redis://localhost:6379
PORT=4000
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BULL_CONCURRENCY=5
BULL_MAX_ATTEMPTS=5
BULL_BACKOFF_MS=1000
RPC_CONFIRMATION_COMMITMENT=confirmed
RPC_CONFIRMATION_TIMEOUT_MS=60000
RELAYER_API_KEY=

# Phase 5 — Monetization (optional for now)
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
